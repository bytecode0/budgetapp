{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist/server",
    "rootDir": "server",
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/server.tsbuildinfo"
  },
  "include": ["server/**/*"]
}
